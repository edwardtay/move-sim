{
  "name": "movesim",
  "version": "1.0.0",
  "description": "A Tenderly-like transaction simulation and debugging tool for the Movement Network",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "movesim": "./dist/cli/index.js"
  },
  "scripts": {
    "start": "node dist/server-entry.js",
    "build": "tsc",
    "dev": "PORT=3000 ts-node src/server-entry.ts",
    "cli": "ts-node src/cli/index.ts",
    "ui": "cd web && npm run dev",
    "demo": "ts-node examples/demo.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write 'src/**/*.ts'",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "movement",
    "move",
    "blockchain",
    "transaction",
    "simulation",
    "debugging",
    "devex",
    "aptos",
    "tenderly"
  ],
  "author": "MoveSim Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/movesim/movesim"
  },
  "dependencies": {
    "@aptos-labs/ts-sdk": "^1.33.1",
    "axios": "^1.6.0",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.3",
    "commander": "^11.1.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "inquirer": "^8.2.6",
    "ora": "^5.4.1",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/inquirer": "^8.2.10",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}